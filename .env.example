# Template only. Copy to a local .env file and replace the values.
# Never commit .env or put Vercel credentials in VITE_* variables.

APP_ENV=development
APP_NAME=Nexo Analytics
API_V1_PREFIX=/api/v1

# API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Single administrator for this first version.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SESSION_TTL_MINUTES=30
DASHBOARD_EMAIL=you@example.com
DASHBOARD_PASSWORD_HASH=

# Vercel Web Analytics. The token is read by Python only.
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=
VERCEL_PROJECT_DOMAIN=luca-toniolo.vercel.app
VERCEL_API_BASE_URL=https://api.vercel.com/v1/query/web-analytics

# Nexo first-party portfolio collection. The site ID is public; it is not a secret.
PORTFOLIO_SITE_ID=lvc4br-lv-portfolio
PORTFOLIO_DOMAIN=luca-toniolo.vercel.app
PORTFOLIO_ALLOWED_ORIGINS=http://localhost:4173,https://luca-toniolo.vercel.app
TRACKER_RATE_LIMIT_PER_MINUTE=120
TRACKER_EVENT_RETENTION_DAYS=365
# Optional coarse geolocation source when the Nexo API itself is behind an edge proxy.
# Use "vercel" or "cloudflare" only when that provider is the trusted proxy in front of this API.
GEOLOCATION_PROXY=none

# Local development defaults to a SQLite file in services/api/.data.
# Production must use a persistent PostgreSQL URL, for example postgresql+psycopg://...
DATABASE_URL=

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

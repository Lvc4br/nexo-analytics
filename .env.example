# Template only. Copy to a local .env file and replace placeholders.
# Never commit real credentials.

APP_ENV=development
APP_NAME=Nexo Analytics
API_V1_PREFIX=/api/v1

# API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database - placeholder; adapt to the chosen driver/ORM
DATABASE_URL=postgresql://nexo_user:change_me@localhost:5432/nexo_analytics

# Authentication - generate a strong random secret locally
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false

# Collection
COLLECTOR_RATE_LIMIT_PER_MINUTE=120
EVENT_MAX_PAYLOAD_BYTES=16384

# Privacy/retention values are provisional and must be decided before production
RAW_EVENT_RETENTION_DAYS=30
SESSION_RETENTION_DAYS=90

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
